# ─── Obrigatório ────────────────────────────────────────────────
# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ─── Modelo de linguagem ────────────────────────────────────────
# Modelo padrão: Gemini 3.5 Flash Lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Temperatura 0 = correções o mais estáveis possível entre execuções
GEMINI_TEMPERATURE=0
# Máximo de chamadas simultâneas ao Gemini (reduza se receber erro 429)
GEMINI_MAX_CONCURRENCY=4

# ─── Embeddings ─────────────────────────────────────────────────
# fastembed = local, multilingual-e5-large (1024 dims); baixa ~2 GB na 1ª vez
# gemini    = gemini-embedding-001 via API (1024 dims), sem download local
EMBEDDING_PROVIDER=fastembed
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Recuperação (RAG) ──────────────────────────────────────────
# Trechos por competência incluídos no prompt
RAG_TOP_K=5
# Limiar de z-score (canal denso) para um trecho ser considerado relevante
RAG_MIN_DENSE_Z=1.0
# Posição máxima no ranking BM25 para um trecho ser considerado relevante
RAG_BM25_MAX_RANK=3
# Constante do Reciprocal Rank Fusion
RAG_RRF_K=60

# ─── Limite de requisições (erro 429) ───────────────────────────
# Espera máxima, em segundos, de cada chamada antes de desistir (correção avulsa)
GEMINI_RATE_LIMIT_MAX_WAIT=120
# Pausas de um experimento quando o limite persiste (30 s, 1, 2, 4, 5, 5... min) antes de pausá-lo
EXPERIMENT_RATE_LIMIT_PAUSES=8
